{
 "title": "Sign-in flows",
 "meta": "example · HTML mock-ups · show-me flow",
 "lead": {
  "answer": "A person reaches the home screen in one try, or after one fixed mistake.",
  "points": [
   "Every failure keeps what the person typed and has a way back.",
   "No message says whether an email has an account."
  ]
 },
