  {
   "id": "reset-password",
   "label": "Reset password",
   "platform": "iOS · mock-ups",
   "frame": "phone",
   "start": "ask",
   "states": [
    {
     "id": "ask",
     "title": "Reset password",
     "sub": "Ask for the email",
     "html": "<div style='padding:44px 22px 28px;font:16px/1.5 var(--sans);color:var(--ink);min-height:780px;background:var(--paper)'><h3 style='margin:0 0 6px;font-size:26px'>Reset password</h3><p style='margin:0 0 20px;color:var(--muted)'>We send a link to your email.</p><label style='display:block;font-size:14px;color:var(--muted)'>Email</label><div style='border:1px solid var(--line);border-radius:10px;padding:12px;margin:4px 0 14px'>ana@example.com</div><div style='background:var(--note);color:var(--paper);border-radius:10px;padding:12px;text-align:center;font-weight:600;margin-top:8px'>Send link</div></div>"
    },
    {
     "id": "sent",
     "title": "Check your email",
     "sub": "Link sent",
     "note": "The app shows this screen for every email, known or not.",
     "html": "<div style='padding:44px 22px 28px;font:16px/1.5 var(--sans);color:var(--ink);min-height:780px;background:var(--paper)'><h3 style='margin:0 0 6px;font-size:26px'>Check your email</h3><p style='margin:0 0 20px;color:var(--muted)'>If ana@example.com has an account, a link is on its way.</p><div style='background:var(--note);color:var(--paper);border-radius:10px;padding:12px;text-align:center;font-weight:600;margin-top:8px'>Open mail app</div><div style='background:var(--fill);color:var(--muted);border:1px solid var(--line);border-radius:10px;padding:12px;text-align:center;font-weight:600;margin-top:8px'>Send again</div></div>"
    },
    {
     "id": "expired",
     "title": "Link expired",
     "sub": "Older than 30 minutes",
     "html": "<div style='padding:44px 22px 28px;font:16px/1.5 var(--sans);color:var(--ink);min-height:780px;background:var(--paper)'><h3 style='margin:0 0 6px;font-size:26px'>This link has expired</h3><p style='margin:0 0 20px;color:var(--muted)'>Links work for 30 minutes.</p><div style='background:var(--note);color:var(--paper);border-radius:10px;padding:12px;text-align:center;font-weight:600;margin-top:8px'>Send a new link</div></div>"
    },
    {
     "id": "new",
     "title": "New password",
     "sub": "Link is valid",
     "html": "<div style='padding:44px 22px 28px;font:16px/1.5 var(--sans);color:var(--ink);min-height:780px;background:var(--paper)'><h3 style='margin:0 0 6px;font-size:26px'>Choose a new password</h3><div style='height:12px'></div><label style='display:block;font-size:14px;color:var(--muted)'>New password</label><div style='border:1px solid var(--line);border-radius:10px;padding:12px;margin:4px 0 14px'>••••••••••</div><div style='background:var(--note);color:var(--paper);border-radius:10px;padding:12px;text-align:center;font-weight:600;margin-top:8px'>Save</div></div>"
    }
