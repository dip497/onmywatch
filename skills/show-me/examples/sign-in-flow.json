   "platform": "iOS · mock-ups",
   "frame": "phone",
   "summary": "From the sign-in screen to the home screen, with every way it can fail.",
   "start": "form",
   "states": [
    {
     "id": "form",
     "title": "Sign in",
     "sub": "Empty form",
     "note": "Both fields are empty. The button stays on, so a person learns the rules by trying.",
     "html": "<div style='padding:44px 22px 28px;font:16px/1.5 var(--sans);color:var(--ink);min-height:780px;background:var(--paper)'><h3 style='margin:0 0 6px;font-size:26px'>Sign in</h3><p style='margin:0 0 20px;color:var(--muted)'>Welcome back.</p><label style='display:block;font-size:14px;color:var(--muted)'>Email</label><div style='border:1px solid var(--line);border-radius:10px;padding:12px;margin:4px 0 14px'>&nbsp;</div><label style='display:block;font-size:14px;color:var(--muted)'>Password</label><div style='border:1px solid var(--line);border-radius:10px;padding:12px;margin:4px 0 14px'>&nbsp;</div><div style='background:var(--note);color:var(--paper);border-radius:10px;padding:12px;text-align:center;font-weight:600;margin-top:8px'>Sign in</div><p style='text-align:center;color:var(--note);margin-top:18px'>Forgot password?</p></div>"
    },
    {
     "id": "email-ok",
     "decision": "Email looks valid?"
    },
    {
     "id": "bad-email",
     "title": "Sign in",
     "sub": "Email is not valid",
     "note": "The app checks the shape of the email before it sends anything.",
     "html": "<div style='padding:44px 22px 28px;font:16px/1.5 var(--sans);color:var(--ink);min-height:780px;background:var(--paper)'><h3 style='margin:0 0 6px;font-size:26px'>Sign in</h3><p style='margin:0 0 20px;color:var(--muted)'>Welcome back.</p><label style='display:block;font-size:14px;color:var(--muted)'>Email</label><div style='border:1.5px solid var(--bad);border-radius:10px;padding:12px;margin:4px 0 14px'>ana@</div><div style='color:var(--bad);font-size:14px;margin:-8px 0 12px'>Enter an email like name@example.com.</div><label style='display:block;font-size:14px;color:var(--muted)'>Password</label><div style='border:1px solid var(--line);border-radius:10px;padding:12px;margin:4px 0 14px'>••••••••</div><div style='background:var(--note);color:var(--paper);border-radius:10px;padding:12px;text-align:center;font-weight:600;margin-top:8px'>Sign in</div></div>"
    },
    {
     "id": "checking",
     "title": "Checking",
     "sub": "Waiting for the server",
     "html": "<div style='padding:44px 22px 28px;font:16px/1.5 var(--sans);color:var(--ink);min-height:780px;background:var(--paper)'><h3 style='margin:0 0 6px;font-size:26px'>Sign in</h3><p style='margin:0 0 20px;color:var(--muted)'>Welcome back.</p><label style='display:block;font-size:14px;color:var(--muted)'>Email</label><div style='border:1px solid var(--line);border-radius:10px;padding:12px;margin:4px 0 14px'>ana@example.com</div><label style='display:block;font-size:14px;color:var(--muted)'>Password</label><div style='border:1px solid var(--line);border-radius:10px;padding:12px;margin:4px 0 14px'>••••••••</div><div style='background:var(--fill);color:var(--muted);border:1px solid var(--line);border-radius:10px;padding:12px;text-align:center;font-weight:600;margin-top:8px'>Signing in…</div></div>"
    },
    {
     "id": "answer",
     "decision": "Server answer?"
    },
    {
     "id": "wrong",
     "title": "Sign in",
     "sub": "Wrong email or password",
     "note": "The message names neither field, so nobody can learn which emails have accounts.",
     "html": "<div style='padding:44px 22px 28px;font:16px/1.5 var(--sans);color:var(--ink);min-height:780px;background:var(--paper)'><h3 style='margin:0 0 6px;font-size:26px'>Sign in</h3><div style='height:12px'></div><div style='border-left:4px solid var(--bad);background:var(--fill);padding:10px 12px;margin-bottom:16px;color:var(--bad)'>That email and password do not match.</div><label style='display:block;font-size:14px;color:var(--muted)'>Email</label><div style='border:1px solid var(--line);border-radius:10px;padding:12px;margin:4px 0 14px'>ana@example.com</div><label style='display:block;font-size:14px;color:var(--muted)'>Password</label><div style='border:1px solid var(--line);border-radius:10px;padding:12px;margin:4px 0 14px'>&nbsp;</div><div style='background:var(--note);color:var(--paper);border-radius:10px;padding:12px;text-align:center;font-weight:600;margin-top:8px'>Sign in</div></div>"
    },
    {
     "id": "offline",
     "title": "No connection",
     "sub": "Request failed",
     "html": "<div style='padding:44px 22px 28px;font:16px/1.5 var(--sans);color:var(--ink);min-height:780px;background:var(--paper)'><h3 style='margin:0 0 6px;font-size:26px'>No connection</h3><p style='margin:0 0 20px;color:var(--muted)'>Check your internet and try again. What you typed is kept.</p><div style='background:var(--note);color:var(--paper);border-radius:10px;padding:12px;text-align:center;font-weight:600;margin-top:8px'>Try again</div></div>"
    },
    {
     "id": "workspace",
     "decision": "Has a workspace?"
    },
    {
     "id": "home",
     "title": "Home",
     "sub": "Signed in",
     "html": "<div style='padding:44px 22px 28px;font:16px/1.5 var(--sans);color:var(--ink);min-height:780px;background:var(--paper)'><h3 style='margin:0 0 6px;font-size:26px'>Welcome back, Ana</h3><p style='margin:0 0 20px;color:var(--muted)'>You have 3 open tasks.</p><div style='border:1px solid var(--hair);border-radius:10px;padding:12px;margin-bottom:8px'>Review the March report</div><div style='border:1px solid var(--hair);border-radius:10px;padding:12px;margin-bottom:8px'>Call the supplier</div><div style='border:1px solid var(--hair);border-radius:10px;padding:12px;margin-bottom:8px'>Book the team room</div></div>"
    },
    {
     "id": "setup",
     "title": "Create a workspace",
     "sub": "First sign-in",
     "html": "<div style='padding:44px 22px 28px;font:16px/1.5 var(--sans);color:var(--ink);min-height:780px;background:var(--paper)'><h3 style='margin:0 0 6px;font-size:26px'>Create a workspace</h3><p style='margin:0 0 20px;color:var(--muted)'>A workspace holds your team's tasks.</p><label style='display:block;font-size:14px;color:var(--muted)'>Workspace name</label><div style='border:1px solid var(--line);border-radius:10px;padding:12px;margin:4px 0 14px'>Ana's team</div><div style='background:var(--note);color:var(--paper);border-radius:10px;padding:12px;text-align:center;font-weight:600;margin-top:8px'>Create</div></div>"
    }
   ],
